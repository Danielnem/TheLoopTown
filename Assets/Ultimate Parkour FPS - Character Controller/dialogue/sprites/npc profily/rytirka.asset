MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51d0008f3f63b2d4299f870e8bbf4f64, type: 3}
  m_Name: rytirka
  m_EditorClassIdentifier: 
  npcName: Rytirka
  neutralSprite: {fileID: 21300000, guid: 5926737fe7b3ebd4a884e805af42e2e2, type: 3}
  happySprite: {fileID: 21300000, guid: b37f077959ad6334c84805cf1b0f7d05, type: 3}
  negativeSprite: {fileID: 21300000, guid: eae1dafbb1cd7c2499525d2727a66024, type: 3}
  introLine: "\"Good morrow, mine own sweeting; I have heard tell thou art presently
    loosing shafts upon thy foes. Speak true\u2014doth this tale bear merit?\""
  options:
  - text: '>"Yeah, I''m killin'' folk."'
    type: 0
    resultText: "\"Marvellous, verily I knew thou wert a mad wretch with a lust for
      slaying \u2014 and by my troth, 'tis that which I do most adore in thee!\""
  - text: '>"S-sorry, you''re breakin'' up (start making noises with your mouth)."'
    type: 1
    resultText: "\"Halloo? Halloo? I hear thee not! 'Tis no great trouble \u2014
      I shall call upon thee anon.\"\n\n"
  - text: '"No, absolutely not, I''m a normal person who don''t shoot folk."'
    type: 2
    resultText: '"By Saint Cyber George, ne''er did I reckon I had given mine heart
      to such a craven soul! I do despise peace-lovers of thy sort!"'
